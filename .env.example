# PostgreSQL en Supabase. Usa el Transaction Pooler durante la ejecución.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:6543/postgres

# Conexión directa o Session Pooler para ejecutar migraciones.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres

# MongoDB Atlas. Esta dirección y su contraseña son privadas.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=green_days

# Supabase Auth. Son valores públicos; no uses aquí la contraseña de PostgreSQL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcional: cuenta exclusiva para pruebas E2E. Nunca uses aquí tu cuenta personal.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
